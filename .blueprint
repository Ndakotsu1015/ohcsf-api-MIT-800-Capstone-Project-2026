created:
    - app/Http/Controllers/CadreController.php
    - app/Http/Controllers/GradeLevelController.php
    - database/factories/CadreFactory.php
    - database/factories/GradeLevelFactory.php
    - database/migrations/2025_03_19_141506_create_cadres_table.php
    - database/migrations/2025_03_19_141507_create_grade_levels_table.php
    - app/Models/Cadre.php
    - app/Models/GradeLevel.php
    - database/seeders/CadreSeeder.php
    - database/seeders/GradeLevelSeeder.php
    - tests/Feature/Http/Controllers/CadreControllerTest.php
    - tests/Feature/Http/Controllers/GradeLevelControllerTest.php
    - app/Http/Requests/CadreStoreRequest.php
    - app/Http/Requests/CadreUpdateRequest.php
    - app/Http/Requests/GradeLevelStoreRequest.php
    - app/Http/Requests/GradeLevelUpdateRequest.php
    - app/Http/Resources/CadreCollection.php
    - app/Http/Resources/CadreResource.php
    - app/Http/Resources/GradeLevelCollection.php
    - app/Http/Resources/GradeLevelResource.php
updated:
    - routes/api.php
models:
    GeopoliticalZone: { name: string, relationships: { hasMany: State } }
    State: { name: string, geopolitical_zone_id: 'id foreign:GeopoliticalZone', relationships: { hasMany: Lga } }
    Lga: { name: string, state_id: 'id foreign:State' }
    Ministry: { name: string }
    Agency: { name: string, ministry_id: 'id foreign:Ministry' }
    Branch: { name: string, relation_id: number, source: 'enum:Ministry,Agency' }
    Designation: { name: string }
    Department: { name: string, branch_id: 'id foreign:Branch', relationships: { hasMany: Division } }
    Division: { name: string, department_id: 'id foreign:Department', relationships: { hasMany: Unit } }
    Unit: { name: string, division_id: 'id foreign:Division' }
    Deployment: { passport_file: 'string nullable', title: 'enum:Mr,Mrs,Miss', first_name: string, middle_name: 'string nullable', last_name: string, date_birth: date, assuption_duty_date: date, deployment_report_date: date, gender: 'enum:Male,Female', marital_status: 'enum:Single,Married,Divorced,Widowed', residential_address: text, permanent_address: text, phone_number: string, nationality: string, nin: 'string unique', lga_id: 'id foreign:Lga', email_address: 'string unique', IPPS_no: 'string unique', employee_no: 'string unique', designation_id: 'id foreign:Designation', unit_id: 'id foreign:Unit', cadre: 'enum:Director,Senior,Junior', grade_level: 'enum:01,02,03,04,05,06,07,08,09,10,11,12,13,14,15,16,17', qualification: json }
    Redeployment: { unit_id: 'id foreign:Unit', designation_id: 'id foreign:Designation', request_type: 'enum:Special,Compassionate', deployment_id: 'id foreign:Deployment', benefit: 'text nullable', request_letter_file: 'string nullable', effective_date: date, end_date_report: 'date nullable', remarks: 'text nullable' }
    Cadre: { name: string, description: 'text nullable', relationships: { hasMany: 'GradeLevel, Deployment' } }
    GradeLevel: { level: string, description: 'text nullable', relationships: { belongsTo: Cadre, hasMany: Deployment } }
